@model PortalInmobiliario.Models.Inmueble
@{
    ViewData["Title"] = "Detalle de Inmueble";
    // Verificar si hay reserva activa
    var reservaActiva = ViewBag.ReservaActiva as bool?;
}

<h2>@ViewData["Title"]</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Model.Titulo</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p class="card-text"><strong>Código:</strong> @Model.Codigo</p>
                        <p class="card-text"><strong>Tipo:</strong> @Model.Tipo</p>
                        <p class="card-text"><strong>Ciudad:</strong> @Model.Ciudad</p>
                        <p class="card-text"><strong>Dirección:</strong> @Model.Direccion</p>
                    </div>
                    <div class="col-md-6">
                        <p class="card-text"><strong>Precio:</strong> @Model.Precio.ToString("C")</p>
                        <p class="card-text"><strong>Dormitorios:</strong> @Model.Dormitorios</p>
                        <p class="card-text"><strong>Baños:</strong> @Model.Banos</p>
                        <p class="card-text"><strong>Metros cuadrados:</strong> @Model.MetrosCuadrados m²</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Acciones</h5>
                
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Visitas" asp-action="Agendar" asp-route-id="@Model.Id" class="btn btn-primary btn-lg w-100 mb-2">
                        <i class="fas fa-calendar-plus"></i> Agendar visita
                    </a>
                    
                    @if (reservaActiva != true)
                    {
                        <form asp-controller="Visitas" asp-action="Reservar" asp-route-id="@Model.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-lg w-100 mb-2" onclick="return confirm('¿Está seguro que desea reservar este inmueble por 48 horas?')">
                                <i class="fas fa-lock"></i> Reservar ahora
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Este inmueble ya tiene una reserva activa
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Inicia sesión</a> para agendar una visita o reservar
                    </div>
                }
                
                <a asp-action="Index" class="btn btn-secondary w-100">
                    <i class="fas fa-arrow-left"></i> Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>