@model PortalInmobiliario.Controllers.BrokerDashboardViewModel
@{
    ViewData["Title"] = "Panel Broker";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-chart-bar"></i> Panel Broker</h2>
    <div class="text-muted">
        <i class="fas fa-user-tie"></i> @User.Identity?.Name
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h3 class="card-title">@Model.TotalInmuebles</h3>
                        <p class="card-text">Total Inmuebles</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-home fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h3 class="card-title">@Model.InmueblesActivos</h3>
                        <p class="card-text">Activos</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h3 class="card-title">@Model.VisitasHoy</h3>
                        <p class="card-text">Visitas Hoy</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-calendar-day fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h3 class="card-title">@Model.ReservasActivas</h3>
                        <p class="card-text">Reservas Activas</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-lock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-tools"></i> Gestión de Inmuebles</h5>
            </div>
            <div class="card-body">
                <p>Administra tu cartera de inmuebles: crear, editar, activar/desactivar propiedades.</p>
                <a asp-action="Inmuebles" class="btn btn-primary">
                    <i class="fas fa-home"></i> Ver Inmuebles
                </a>
                <a asp-action="CreateInmueble" class="btn btn-success ms-2">
                    <i class="fas fa-plus"></i> Nuevo Inmueble
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-calendar-alt"></i> Agenda del Día</h5>
            </div>
            <div class="card-body">
                <p>Consulta y gestiona las visitas programadas para hoy.</p>
                <a asp-action="AgendaHoy" class="btn btn-warning">
                    <i class="fas fa-calendar-day"></i> Ver Agenda (@Model.VisitasHoy visitas)
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-lock"></i> Gestión de Reservas</h5>
            </div>
            <div class="card-body">
                <p>Administra las reservas activas y libera inmuebles según sea necesario.</p>
                <a asp-action="Reservas" class="btn btn-info">
                    <i class="fas fa-list"></i> Ver Reservas Activas (@Model.ReservasActivas)
                </a>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <div class="alert alert-info" role="alert">
        <i class="fas fa-info-circle"></i> <strong>Panel Broker:</strong> 
        Desde aquí puedes gestionar todos los aspectos de tu cartera inmobiliaria: propiedades, visitas y reservas.
    </div>
</div>